[Unit]
Description=Rotinas da Secretaria (lembretes, agenda, triagem, briefing, avisos)

[Service]
Type=oneshot
User=plastimanaus
WorkingDirectory=/opt/plastimanaus
EnvironmentFile=/opt/plastimanaus/.env
Environment=HOME=/home/plastimanaus
ExecStart=/opt/plastimanaus/.venv/bin/python manage.py rotinas_secretaria
TimeoutStartSec=900
