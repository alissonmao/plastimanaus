[Unit]
Description=ERP Plasti Manaus (gunicorn)
After=network.target postgresql.service

[Service]
User=plastimanaus
Group=www-data
WorkingDirectory=/opt/plastimanaus
EnvironmentFile=/opt/plastimanaus/.env
ExecStart=/opt/plastimanaus/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
